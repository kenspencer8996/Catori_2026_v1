<UserControl x:Class="CatoriUCLibrary.Views.SuperMarioUC" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CatoriUCLibrary.Views.SuperMario.GameObjects" Background="#101b30">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="SUPER MARIO BROTHERS" Foreground="#ffe5a0" FontSize="28" FontWeight="Bold"/><TextBlock Text="WORLD 1–1 · THE GREEN HILLS" Foreground="#96b6d7" FontSize="13" Margin="0,5,0,0"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><TextBlock Text="Move: ← → / A D · Jump: Space / Z · Run: Shift · Pause: P / Esc · Restart: R" Foreground="#cfdae9"/><TextBlock x:Name="ControllerStatus" Text="Controller: searching… · Gamepad: D-pad / stick · A jump · X run · Start pause · Back restart" Foreground="#96b6d7" Margin="0,5,0,0"/></StackPanel>
  <Viewbox Stretch="Uniform"><local:GameSurface x:Name="Playfield" Width="960" Height="540" Focusable="True"/></Viewbox>
 </DockPanel>
</UserControl>
