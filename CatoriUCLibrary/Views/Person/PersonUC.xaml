<UserControl x:Class="CatoriUCLibrary.Views.Person.PersonUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Width="300" Height="400"
             d:DesignHeight="400" d:DesignWidth="300"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="PersonRoot" Width="300" Height="400" Background="Transparent">
            <Canvas x:Name="LeftLegRoot" IsHitTestVisible="False">
                <Image x:Name="LeftLegImage" Stretch="Fill"/>
                <Image x:Name="LeftLowerLegImage" Stretch="Fill"/>
            </Canvas>
            <Canvas x:Name="RightLegRoot" IsHitTestVisible="False">
                <Image x:Name="RightLegImage" Stretch="Fill"/>
                <Image x:Name="RightLowerLegImage" Stretch="Fill"/>
            </Canvas>
            <Image x:Name="BodyImage" Stretch="Uniform" Width="300" Height="400" IsHitTestVisible="False"/>
            <Image x:Name="HeadImage" Stretch="Uniform" IsHitTestVisible="False"/>
            <Canvas x:Name="LeftArmRoot" IsHitTestVisible="False">
                <Image x:Name="LeftArmImage" Stretch="Fill"/>
                <Image x:Name="LeftForearmImage" Stretch="Fill"/>
            </Canvas>
            <Canvas x:Name="RightArmRoot">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="ArmRotate"/>
                </Canvas.RenderTransform>
            <Image x:Name="ArmImage" Stretch="Fill" Width="155" Height="55"
                   RenderTransformOrigin="0,0.5" Cursor="Hand"
                   MouseLeftButtonDown="ArmImage_MouseLeftButtonDown"
                   MouseMove="ArmImage_MouseMove"
                   MouseLeftButtonUp="ArmImage_MouseLeftButtonUp"/>
                <Image x:Name="RightForearmImage" Stretch="Fill" IsHitTestVisible="False"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
