<UserControl x:Class="CatoriUCLibrary.Views.PacmanUC" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CatoriUCLibrary.Views.Pacman.GameObjects" Focusable="True" Background="#080B17">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="MAZE CHASE" Foreground="#FFE055" FontSize="32" FontWeight="Bold"/><TextBlock x:Name="ScoreText" Foreground="White" FontSize="18" Margin="0,8,0,12"/></StackPanel>
<Viewbox Grid.Row="1" Stretch="Uniform"><local:MazeSurface x:Name="Surface" Width="504" Height="552"/></Viewbox>
<StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Foreground="#FFE055" FontSize="18" TextWrapping="Wrap"/><TextBlock x:Name="ControllerText" Foreground="#AAB6DA" Margin="0,8,0,0"/><TextBlock Text="Arrows / WASD or D-pad / left stick · P / Start: pause · R / A: restart" Foreground="#AAB6DA" TextWrapping="Wrap" Margin="0,6,0,0"/><Button x:Name="NewGameButton" Content="New game" Click="NewGame_Click" HorizontalAlignment="Left" Padding="18,6" Margin="0,12,0,0"/></StackPanel>
</Grid></UserControl>