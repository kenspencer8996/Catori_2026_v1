<UserControl x:Class="CatoriUCLibrary.Views.Tickets.TicketKioskUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatoriUCLibrary.Views.Tickets"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             PreviewMouseLeftButtonDown="TicketKiosk_MouseLeftButtonDown"
             PreviewMouseMove="TicketKiosk_MouseMove"
             PreviewMouseLeftButtonUp="TicketKiosk_MouseLeftButtonUp">
    <Grid>

        <!-- Ground shadow -->
        <Ellipse Width="220"
                 Height="20"
                 Fill="#554A314A"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,8"/>

        <!-- Pedestal -->
        <Border Width="105"
                Height="190"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                CornerRadius="8"
                Background="#D8463F"
                BorderBrush="#A52E35"
                BorderThickness="3">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="12,18,5,12"
                        CornerRadius="16"
                        Background="#FFB34D"/>

                <Border Grid.Column="1"
                        Background="#B72E3A"
                        CornerRadius="0,0,6,0"/>
            </Grid>
        </Border>

        <!-- Main kiosk -->
        <Border Width="220"
                Height="235"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                CornerRadius="28"
                Background="#E84E48"
                BorderBrush="#A92D36"
                BorderThickness="4">

            <Grid Margin="12">

                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <!-- Destination header -->
                <Border Grid.Row="0"
                        Margin="8,0,8,6"
                        CornerRadius="8"
                        Background="#8E2531">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

      
                        <TextBlock x:Name="DestinationText"
                                   Text="{Binding Destination, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Screen -->
                <Border Grid.Row="1"
                        Margin="15,2,15,8"
                        CornerRadius="8"
                        Background="#263B50"
                        BorderBrush="#6A2630"
                        BorderThickness="5">

                    <Grid>
                        <Border Margin="8"
                                CornerRadius="4"
                                Background="#78B7C8"/>

                        <!-- Screen shine -->
                        <Path Fill="#55FFFFFF"
                              Data="M20,15 L95,15 L55,80 L20,95 Z"/>

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="AIR TRAVEL"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="#203747"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Text,
                                                     ElementName=DestinationText}"
                                       FontWeight="Bold"
                                       FontSize="25"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TicketCost" 
               FontWeight="Bold"
               Text="{Binding Cost, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:C}}" FontSize="15" Foreground="Cyan"
               HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PurchaseStatusTextBlock"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>


                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Controls -->
                <Grid Grid.Row="2"
                      Margin="12,0,12,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ticket / purchase button -->
                    <Button x:Name="BuyTicketButton"
                            Grid.Column="0"
                            Content="BUY TICKET"
                            Background="#F16B69"
                            BorderBrush="#852738"
                            BorderThickness="3"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="13"
                            Click="BuyTicketButton_Click"/>

                    <!-- Card reader -->
                    <Border Grid.Column="2"
                            CornerRadius="7"
                            Background="#F3A947"
                            BorderBrush="#852738"
                            BorderThickness="3">

                        <Grid>
                            <Ellipse Width="16"
                                     Height="10"
                                     Fill="#24354D"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
