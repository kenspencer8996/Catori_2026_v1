<UserControl x:Class="CatoriUCLibrary.Views.Room3DSceneUC"
             x:Name="RoomSceneRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="http://helix-toolkit.org/wpf"
             Background="#E5EDF4" PreviewKeyDown="Room_PreviewKeyDown" PreviewKeyUp="Room_PreviewKeyUp" PreviewMouseDown="Interior_MouseDown" PreviewMouseUp="Interior_MouseUp" PreviewMouseWheel="Interior_MouseWheel" LostKeyboardFocus="Room_LostKeyboardFocus">
    <Grid>
        <h:HelixViewport3D x:Name="RoomViewport" Focusable="True" ShowCoordinateSystem="True" ShowViewCube="True" ZoomExtentsWhenLoaded="False" Background="#E5EDF4" PreviewMouseLeftButtonDown="Room_MouseDown" PreviewMouseMove="Room_MouseMove" PreviewMouseLeftButtonUp="Room_MouseUp" LostMouseCapture="Room_LostCapture" AllowDrop="True" PreviewDragEnter="Room_DragOver" PreviewDragOver="Room_DragOver" PreviewDrop="Room_Drop" DragLeave="Room_DragLeave">
            <h:HelixViewport3D.Camera>
                <PerspectiveCamera Position="10,-13,10" LookDirection="-10,13,-9" UpDirection="0,0,1" FieldOfView="45" />
            </h:HelixViewport3D.Camera>
            <h:DefaultLights />
            <ModelVisual3D x:Name="SceneChildrenVisual" />
            <ModelVisual3D x:Name="SceneDrawingPreviewVisual" />
            <h:SphereVisual3D x:Name="ResizeHandle0" Radius="0.09" Fill="DeepSkyBlue" />
<h:SphereVisual3D x:Name="ResizeHandle1" Radius="0.09" Fill="DeepSkyBlue" />
<h:SphereVisual3D x:Name="ResizeHandle2" Radius="0.09" Fill="DeepSkyBlue" />
<h:SphereVisual3D x:Name="ResizeHandle3" Radius="0.09" Fill="DeepSkyBlue" />
<h:SphereVisual3D x:Name="ResizeHandle4" Radius="0.09" Fill="DeepSkyBlue" />
<h:SphereVisual3D x:Name="ResizeHandle5" Radius="0.09" Fill="DeepSkyBlue" />
<h:SphereVisual3D x:Name="ResizeHandle6" Radius="0.09" Fill="DeepSkyBlue" />
<h:SphereVisual3D x:Name="ResizeHandle7" Radius="0.09" Fill="DeepSkyBlue" />
            <h:TubeVisual3D x:Name="ChildRotationArc" Diameter="0.07" ThetaDiv="12" Fill="DarkOrange" />
            <h:ArrowVisual3D x:Name="ChildRotationArrow" Diameter="0.09" Fill="DarkOrange" />
            <h:BoundingBoxVisual3D x:Name="ChildSelectionBounds" Diameter="0.015" Fill="Gold" />
            <h:GridLinesVisual3D Width="20" Length="20" MinorDistance="1" MajorDistance="5" Thickness="0.015" Center="0,0,-0.12" Fill="#AEBED0" />
            <ModelVisual3D x:Name="SampleEnvironment">
                <h:BoxVisual3D Center="0,0,-0.1" Length="8" Width="6" Height="0.2" Fill="#A78156" />
                <h:BoxVisual3D Center="-4,0,1.5" Length="0.15" Width="6" Height="3" Fill="#737C86" />
                <h:BoxVisual3D Center="-2.4,3,1.5" Length="3.2" Width="0.15" Height="3" Fill="#737C86" />
                <h:BoxVisual3D Center="2.4,3,1.5" Length="3.2" Width="0.15" Height="3" Fill="#737C86" />
                <h:BoxVisual3D Center="0,3,2.7" Length="1.6" Width="0.15" Height="0.6" Fill="#737C86" />
            </ModelVisual3D>
            <ModelVisual3D x:Name="ImportedEnvironment" />
            <ModelVisual3D x:Name="SampleDemonstration">
                <h:TubeVisual3D Path="-2.5,0,0.035 2.5,0,0.035" Diameter="0.04" ThetaDiv="10" Fill="DarkOrange" />
                <h:SphereVisual3D Center="-2.5,0,0.035" Radius="0.08" Fill="LimeGreen" />
                <h:SphereVisual3D Center="2.5,0,0.035" Radius="0.08" Fill="DarkOrange" />
                <ModelVisual3D>
                    <ModelVisual3D.Transform>
                        <TranslateTransform3D x:Name="CharacterPosition" OffsetX="-2.5" />
                    </ModelVisual3D.Transform>
                    <h:BoxVisual3D Center="-0.12,0,0.3" Length="0.17" Width="0.25" Height="0.6" Fill="#244A78" />
                    <h:BoxVisual3D Center="0.12,0,0.3" Length="0.17" Width="0.25" Height="0.6" Fill="#244A78" />
                    <h:BoxVisual3D Center="0,0,0.9" Length="0.5" Width="0.28" Height="0.6" Fill="#DF9540" />
                    <h:SphereVisual3D Center="0,0,1.4" Radius="0.2" Fill="#E8BA8F" />
                </ModelVisual3D>
            </ModelVisual3D>
            <ModelVisual3D x:Name="SampleFurniture">
                <h:BoxVisual3D Center="1.7,1.5,0.8" Length="1.5" Width="0.8" Height="0.12" Fill="#81572F" />
                <h:BoxVisual3D Center="1.15,1.25,0.38" Length="0.1" Width="0.1" Height="0.76" Fill="#81572F" />
                <h:BoxVisual3D Center="2.25,1.25,0.38" Length="0.1" Width="0.1" Height="0.76" Fill="#81572F" />
                <h:BoxVisual3D Center="1.15,1.75,0.38" Length="0.1" Width="0.1" Height="0.76" Fill="#81572F" />
                <h:BoxVisual3D Center="2.25,1.75,0.38" Length="0.1" Width="0.1" Height="0.76" Fill="#81572F" />
            </ModelVisual3D>
        </h:HelixViewport3D>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Padding="14" Background="#E6142033" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="3D scene" Foreground="White" FontSize="22" />
                <TextBlock Text="OBJ environment Â· child models Â· named lines and scene hotspots" Foreground="LightSkyBlue" />
                <TextBlock x:Name="ModelStatusText" Foreground="LightSkyBlue" TextWrapping="Wrap" MaxWidth="650" />
            </StackPanel>
        </Border>
        <Border x:Name="ChildDragIndicator" Visibility="Collapsed" Background="#EF007CB8" Padding="14" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <TextBlock x:Name="ChildDragLabel" Foreground="White" FontSize="20" Text="Drop to place object" />
        </Border>
    </Grid>
</UserControl>
