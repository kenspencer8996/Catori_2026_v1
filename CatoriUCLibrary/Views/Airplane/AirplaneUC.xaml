<UserControl x:Class="CatoriUCLibrary.Views.Airplane.AirplaneUC"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:visualParts="clr-namespace:CatoriUCLibrary.Views.VisualParts"
 xmlns:person="clr-namespace:CatoriUCLibrary.Views.Person" Width="320" Height="180" Background="Transparent"
 AllowDrop="True"
 PreviewMouseLeftButtonDown="AirplaneMouseDown" PreviewMouseMove="AirplaneMouseMove" PreviewMouseLeftButtonUp="AirplaneMouseUp">
 <Grid>
  <visualParts:VisualPartAnimatorUC x:Name="PartAnimator" IsHitTestVisible="False"/>
  <Viewbox Stretch="Uniform">
   <Canvas x:Name="AirplaneRoot" Width="320" Height="180">
    <Image x:Name="BodyImage" Stretch="Fill"/>
    <Image x:Name="LeftWingImage" Stretch="Fill"/>
    <Image x:Name="RightWingImage" Stretch="Fill"/>
    <Image x:Name="LeftPropellerImage" Stretch="Fill"/>
    <Image x:Name="RightPropellerImage" Stretch="Fill"/>
    <Image x:Name="PropellerImage" Stretch="Fill"/>
    <Image x:Name="DoorImage" Stretch="Fill"/>
    <Image x:Name="LandingGearImage" Stretch="Fill"/>
    <Canvas x:Name="SmokeLayer" IsHitTestVisible="False">
     <Ellipse x:Name="LeftSmoke" Width="34" Height="15" Canvas.Left="83" Canvas.Top="104" Fill="#8099A2AA" Opacity="0"/>
     <Ellipse x:Name="RightSmoke" Width="34" Height="15" Canvas.Left="183" Canvas.Top="104" Fill="#8099A2AA" Opacity="0"/>
    </Canvas>
    <Border x:Name="PilotWindshield" Width="43" Height="29" Canvas.Left="75" Canvas.Top="75" Panel.ZIndex="1000"
            CornerRadius="14" ClipToBounds="True" Opacity="0" IsHitTestVisible="False">
     <person:PersonUC x:Name="PilotView" Width="95" Height="126" Margin="-25,-15,0,0" IsDragEnabled="False"/>
    </Border>
    <Border Width="24" Height="18" Canvas.Left="171" Canvas.Top="91" Panel.ZIndex="1000"
            CornerRadius="8" ClipToBounds="True" IsHitTestVisible="False">
     <person:PersonUC x:Name="PassengerView" Width="55" Height="74" Margin="-15,-9,0,0"
                      Opacity="0" IsHitTestVisible="False" IsDragEnabled="False"
                      RenderTransformOrigin="0.5,0.5">
      <person:PersonUC.RenderTransform>
       <ScaleTransform ScaleX="-1"/>
      </person:PersonUC.RenderTransform>
     </person:PersonUC>
    </Border>
   </Canvas>
  </Viewbox>
 </Grid>
</UserControl>
