<UserControl x:Class="CatoriUCLibrary.Views.FactoryControls.FactoryControlPanelUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="180" Background="Transparent">
    <Grid>
        <Border Background="#FF3A4148" BorderBrush="#FF161A1E" BorderThickness="4"
                CornerRadius="12">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CONTROL" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Canvas Grid.Row="1" Width="110" Height="90">
                    <Ellipse x:Name="ButtonVisual" Width="58" Height="58"
                             Canvas.Left="26" Canvas.Top="15" Fill="#FFC62828"
                             Stroke="#FF161616" StrokeThickness="5"
                             MouseLeftButtonUp="ActivationVisual_MouseLeftButtonUp"/>

                    <Grid x:Name="LeverVisual" Width="90" Height="85"
                          Canvas.Left="10" Canvas.Top="2"
                          MouseLeftButtonUp="ActivationVisual_MouseLeftButtonUp">
                        <Ellipse Width="50" Height="24" Fill="#FF171A1D"
                                 VerticalAlignment="Bottom"/>
                        <Border Width="16" Height="68" Background="#FFC7CED4"
                                BorderBrush="#FF202428" BorderThickness="2"
                                CornerRadius="6" RenderTransformOrigin="0.5,0.85">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="LeverRotate" Angle="-25"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Canvas>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="StatusLight" Width="18" Height="18"
                             Fill="#FF5B2020" Stroke="#FF111111" StrokeThickness="2"/>
                    <TextBlock Text=" READY" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
