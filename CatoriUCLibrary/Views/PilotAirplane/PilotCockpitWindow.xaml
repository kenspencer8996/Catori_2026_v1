<Window x:Class="CatoriUCLibrary.Views.PilotCockpitWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pilot cockpit" Width="1200" Height="800" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="#101922" PreviewKeyDown="OnKeyDown" PreviewKeyUp="OnKeyUp">
 <Viewbox Stretch="Uniform"><Grid Width="1200" Height="760">
  <Border Height="520" VerticalAlignment="Top" ClipToBounds="True"><Canvas>
   <Canvas x:Name="Landscape" Width="2200" Height="1600" Canvas.Left="-500" Canvas.Top="-550" RenderTransformOrigin="0.5,0.5"><Canvas.RenderTransform><TransformGroup><RotateTransform x:Name="HorizonBank"/><TranslateTransform x:Name="HorizonPitch"/></TransformGroup></Canvas.RenderTransform>
    <Rectangle Width="2200" Height="800"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#267EC3"/><GradientStop Color="#BCEAF3" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Rectangle Width="2200" Height="800" Canvas.Top="800"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#567C47"/><GradientStop Color="#1E462D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Ellipse Width="75" Height="75" Canvas.Left="1420" Canvas.Top="480" Fill="#FFFFD5"/>
    <Path Data="M 0,800 L 200,710 L 310,770 L 480,660 L 650,790 L 840,710 L 1000,800 L 1300,750 L 1450,680 L 1620,780 L 1840,720 L 2200,800 Z" Fill="#466D68"/>
    <Path Data="M 1090,800 L 1110,800 L 1330,1600 L 870,1600 Z" Fill="#60705D"/>
    <Path Data="M 1100,810 L 1100,1590" Stroke="#D3D7B2" StrokeThickness="4" StrokeDashArray="8,12"/>
    <Path Data="M 0,990 Q 400,820 740,970 T 1450,1000 T 2200,900" Stroke="#699DA2" StrokeThickness="32"/>
   </Canvas>
  </Canvas></Border>
  <Path Data="M 0,0 L 140,0 L 65,520 L 0,570 Z M 1060,0 L 1200,0 L 1200,570 L 1135,520 Z" Fill="#26323C" Stroke="#566573" StrokeThickness="4"/>
  <Path Data="M 575,0 L 625,0 L 650,520 L 550,520 Z" Fill="#283541" Stroke="#71818C" StrokeThickness="3"/>
  <TextBlock Text="PILOT VIEW" Margin="170,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" FontSize="22" FontWeight="Bold"/>
  <Path Data="M 540,300 L 575,300 M 625,300 L 660,300 M 600,285 L 600,315" Stroke="#FFFFB5" StrokeThickness="3"/>
  <Border VerticalAlignment="Bottom" Height="265" Background="#17212C" BorderBrush="#566373" BorderThickness="0,8,0,0" CornerRadius="36,36,0,0"><Grid Margin="45,25,45,20">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Margin="10"><TextBlock Text="AIRSPEED" Foreground="#A5BDC8" FontSize="16"/><TextBlock x:Name="SpeedText" Foreground="#9EF3D1" FontSize="46" FontFamily="Consolas"/><TextBlock Text="knots" Foreground="#A5BDC8"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="10"><TextBlock Text="ALTITUDE" Foreground="#A5BDC8" FontSize="16"/><TextBlock x:Name="AltitudeText" Foreground="#9EF3D1" FontSize="46" FontFamily="Consolas"/><TextBlock Text="metres" Foreground="#A5BDC8"/><TextBlock x:Name="AttitudeText" Foreground="White" FontSize="16" Margin="0,20,0,0"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="10"><TextBlock Text="HEADING" Foreground="#A5BDC8" FontSize="16"/><TextBlock x:Name="HeadingText" Foreground="#9EF3D1" FontSize="46" FontFamily="Consolas"/><TextBlock Text="degrees" Foreground="#A5BDC8"/></StackPanel>
   <StackPanel Grid.Column="3" Margin="10"><TextBlock Text="THROTTLE" Foreground="#A5BDC8" FontSize="16"/><TextBlock x:Name="ThrottleText" Foreground="#FFDE8A" FontSize="46" FontFamily="Consolas"/><ProgressBar x:Name="ThrottleGauge" Height="18" Maximum="100" Foreground="#FFDE8A" Background="#09121C" Margin="0,12,0,0"/></StackPanel>
   <TextBlock Grid.ColumnSpan="4" VerticalAlignment="Bottom" Text="RIGHT STICK: bank / pitch    LEFT STICK: throttle    B / ESC: return    Keyboard: arrows + Page Up / Down" Foreground="#C1CED5" FontSize="15"/>
  </Grid></Border>
 </Grid></Viewbox>
</Window>