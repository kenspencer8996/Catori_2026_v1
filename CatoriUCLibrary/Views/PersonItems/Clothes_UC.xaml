<UserControl x:Class="CatoriUCLibrary.Views.PersonItems.Clothes_UC" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="120" Height="100" Background="Transparent" PreviewMouseLeftButtonDown="Clothes_MouseLeftButtonDown" PreviewMouseMove="Clothes_MouseMove">
    <Border x:Name="ClothesBorder" Background="#FF4D83C2" BorderBrush="#FF173B65" BorderThickness="2" CornerRadius="8" Padding="8">
        <StackPanel><TextBlock x:Name="ClothesIconTextBlock" Text="CLOTHES" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="ClothesNameTextBlock" Text="{Binding Name, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel>
    </Border>
</UserControl>
