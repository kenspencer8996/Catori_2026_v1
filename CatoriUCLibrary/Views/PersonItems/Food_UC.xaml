<UserControl x:Class="CatoriUCLibrary.Views.PersonItems.Food_UC" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="100" Height="100" Background="Transparent" PreviewMouseLeftButtonDown="Food_MouseLeftButtonDown" PreviewMouseMove="Food_MouseMove">
    <Border x:Name="FoodBorder" Background="#FFF0A24A" BorderBrush="#FF804513" BorderThickness="2" CornerRadius="50" Padding="8">
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="FoodTitleTextBlock" Text="FOOD" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="FoodNameTextBlock" Text="{Binding Name, RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel>
    </Border>
</UserControl>
