<UserControl x:Class="CatoriUCLibrary.Views.AvatarBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CatoriUCLibrary.Views"
             IsHitTestVisible="False">
    <Border Background="#CC172736" CornerRadius="4" Padding="6,3">
        <TextBlock Foreground="White" Text="{Binding Path=(views:AvatarMoney.Balance), RelativeSource={RelativeSource AncestorType={x:Type views:PersonUC}}, StringFormat=Balance: {0:N2}}" />
    </Border>
</UserControl>
