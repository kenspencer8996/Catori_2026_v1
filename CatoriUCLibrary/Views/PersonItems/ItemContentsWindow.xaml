<Window x:Class="CatoriUCLibrary.Views.ItemContentsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CatoriUCLibrary.Views" Width="420" Height="330" Background="#172431" WindowStartupLocation="CenterOwner" AllowDrop="True" DragOver="Contents_DragOver" Drop="Contents_Drop">
    <DockPanel Margin="12" Background="Transparent">
        <TextBlock DockPanel.Dock="Top" Text="Drop items here to store them. Drag an item out to a person or another bag." Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12" />
        <ScrollViewer x:Name="PersonItemContentsScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PersonItemContentsList" ItemsSource="{Binding Contents.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ItemUC x:Name="StoredPersonItemControl" Item="{Binding}" Width="80" Height="100" Margin="5" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>