<UserControl x:Class="CatoriUCLibrary.Views.PersonCarriedItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CatoriUCLibrary.Views">
    <ItemsControl x:Name="CarriedItemImages" ItemsSource="{Binding CarriedItems.Items, RelativeSource={RelativeSource AncestorType={x:Type controls:PersonUC}}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <controls:ItemUC x:Name="CarriedItemImage" Item="{Binding}" Width="48" Height="64" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
