<UserControl x:Class="CatoriUCLibrary.Views.PersonItems.Ticket_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180"
             Height="82"
             Background="Transparent"
             PreviewMouseLeftButtonDown="Ticket_MouseLeftButtonDown"
             PreviewMouseMove="Ticket_MouseMove">
    <Border x:Name="TicketBorder" Background="#FFF7D87A" BorderBrush="#FF795B16" BorderThickness="2" CornerRadius="5" Padding="9">
        <Grid>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock x:Name="TicketTitleTextBlock" Text="TRAVEL TICKET" FontWeight="Bold"/>
            <TextBlock x:Name="TicketDestinationTextBlock" Grid.Row="1" Text="{Binding Destination, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <TextBlock x:Name="TicketCostTextBlock" Grid.Row="2" Text="{Binding Cost, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Cost: {0:C}}"/>
        </Grid>
    </Border>
</UserControl>
