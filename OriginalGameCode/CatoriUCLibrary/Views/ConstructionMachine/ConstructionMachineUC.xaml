<UserControl x:Class="CatoriUCLibrary.Views.ConstructionMachine.ConstructionMachineUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:visualParts="clr-namespace:CatoriUCLibrary.Views.VisualParts"
             Background="Transparent"
             Width="300"
             Height="220">
    <Grid>
        <visualParts:VisualPartAnimatorUC x:Name="MachinePartAnimator" IsHitTestVisible="False"/>
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="MachineRoot" Width="300" Height="220" Background="Transparent">
                    <Image x:Name="BasePartImage" Stretch="Fill"/>
                    <Canvas x:Name="BoomPartRoot">
                        <Image x:Name="BoomPartImage" Stretch="Fill"/>
                        <Canvas x:Name="ArmPartRoot">
                            <Image x:Name="ArmPartImage" Stretch="Fill"/>
                            <Canvas x:Name="BucketPartRoot">
                                <Image x:Name="BucketPartImage" Stretch="Fill"/>
                            </Canvas>
                        </Canvas>
                    </Canvas>
                </Canvas>
            </Viewbox>
    </Grid>
</UserControl>
