<Window x:Class="CatoriApp.Maintenance.Views.Production.FactoryCapabilityListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factory Capabilities"
        Height="760"
        Width="1160"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Background="{DynamicResource MainGradient}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Content="Factory Capabilities" Style="{DynamicResource RedBoldLabelStyle}" />
        <Button Grid.Column="1" Content="New" MinWidth="50" Width="100" Height="25" Click="NewButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
        <Button Grid.Column="2" Style="{StaticResource MapHotspotButton}" Width="50" Height="50" Click="ExitButton_Click" ToolTip="Click to exit" Panel.ZIndex="1002" />

        <DataGrid x:Name="MainDataGrid" Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource MainGradient}"
                  ItemsSource="{Binding FactoryCapabilities}" SelectedItem="{Binding SelectedFactoryCapability, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding FactoryCapabilityId}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="Location Id" Binding="{Binding LocationId, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                <DataGridTextColumn Header="Capability Type" Binding="{Binding CapabilityType, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                <DataGridTextColumn Header="Capability Name" Binding="{Binding CapabilityName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="90" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="8,6,8,8" />
    </Grid>
</Window>