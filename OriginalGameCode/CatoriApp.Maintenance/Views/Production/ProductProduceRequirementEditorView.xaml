<Window x:Class="CatoriApp.Maintenance.Views.Production.ProductProduceRequirementEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Produce Requirement Detail" Height="360" Width="720" WindowStartupLocation="CenterOwner" Background="{DynamicResource MainGradient}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="45" /></Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Product Produce Requirement Detail" Style="{DynamicResource RedBoldLabelStyle}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Product Id" /><TextBox Grid.Row="0" Grid.Column="1" Width="140" HorizontalAlignment="Left" Text="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="1" Content="Required Type" /><TextBox Grid.Row="1" Grid.Column="1" MinWidth="320" HorizontalAlignment="Left" Text="{Binding RequiredCapabilityType, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="2" Content="Required Name" /><TextBox Grid.Row="2" Grid.Column="1" MinWidth="320" HorizontalAlignment="Left" Text="{Binding RequiredCapabilityName, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="3" Content="Minimum Factory Level" /><TextBox Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding MinimumFactoryLevel, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
            <Button Content="Ok" Width="80" Click="OkButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
        </StackPanel>
    </Grid>
</Window>