<Window x:Class="CatoriApp.Game.Views.Manufacturing.ComponentListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Components"
        Height="640"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        WindowStyle="None"
        Background="{DynamicResource MainGradient}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Components"
                   FontSize="28"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ViewHeaderForeground}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="New" Width="86" Height="30" Margin="6,0,0,0" Click="NewButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
            <Button Content="Edit" Width="86" Height="30" Margin="6,0,0,0" Click="EditButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
            <Button Content="Save" Width="86" Height="30" Margin="6,0,0,0" Click="SaveButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
            <Button Content="Delete" Width="86" Height="30" Margin="6,0,0,0" Click="DeleteButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
            <Button Content="Close" Width="86" Height="30" Margin="6,0,0,0" Click="CloseButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
        </StackPanel>

        <DataGrid x:Name="ComponentsDataGrid"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="0,10,0,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  SelectionMode="Single"
                  Background="{x:Null}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding ComponentId}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="Name" Binding="{Binding ComponentName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="140" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Margin="0,8,0,0"
                   Foreground="White"
                   TextWrapping="Wrap" />
    </Grid>
</Window>