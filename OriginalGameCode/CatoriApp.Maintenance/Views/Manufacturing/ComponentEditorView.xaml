<Window x:Class="CatoriApp.Game.Views.Manufacturing.ComponentEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Component Editor"
        Height="260" Width="520"  WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="{DynamicResource MainGradient}">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Component Detail" Style="{DynamicResource RedBoldLabelStyle}" />
        <Button x:Name="ExitButton"
              Grid.Column="2"  Style="{StaticResource MapHotspotButton}"
              Width="39" Height="30" HorizontalAlignment="Right"
              Click="ExitButton_Click"  ToolTip="Click to exit"
              Panel.ZIndex="1002"/>
        <Label Grid.Row="1" Grid.Column="0" Content="Name"   />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ComponentName, UpdateSourceTrigger=PropertyChanged}"  />

        <Label Grid.Row="2" Grid.Column="0" Content="Quantity used" />
        <TextBox Grid.Row="2" Grid.Column="1" MinWidth="50" MaxWidth="200" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="7" Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" >
            <Button Content="Cancel" Height="30" Width="40"  Click="CancelButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" Margin="0,0,10,0" />
            <Button Content="Ok"  Height="30" Width="40" Click="OkButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" Margin="0,0,10,0" />
        </StackPanel>
    </Grid>
</Window>