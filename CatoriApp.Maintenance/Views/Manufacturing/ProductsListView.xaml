<Window x:Class="CatoriApp.Game.Views.Manufacturing.ProductsListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Products" Height="760"  Width="1180" WindowStyle="None"
        WindowState="Maximized" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Background="{DynamicResource MainGradient}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="ExitButton"
        Grid.Column="4"
        Style="{StaticResource MapHotspotButton}"
        Width="50"
        Height="50" HorizontalAlignment="Right"
        Click="ExitButton_Click"
        ToolTip="Click to exit"
        Panel.ZIndex="1002"/>
        <TextBlock Text="Products" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"  Foreground="{DynamicResource ViewHeaderForeground}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="New" Width="90" Height="30" Margin="6,0,0,0" Click="NewProductButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
                <Button Content="Components" Width="110" Height="30" Margin="6,0,0,0" Click="ComponentsButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
             </StackPanel>
      

        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="1" Grid.ColumnSpan="4"
                  AutoGenerateColumns="False"  
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  SelectionMode="Single" 
                  Background="{x:Null}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding ProductId}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Name" Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding ProductType, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                <DataGridTextColumn Header="Unit" Binding="{Binding UnitOfMeasure, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="Cost" Binding="{Binding CostPerUnit, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="180" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Action" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Open BOM"
                       Foreground="Blue" TextDecorations="Underline"
                       Cursor="Hand"
                       MouseLeftButtonDown="BomText_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="MinHeight" Value="140"/>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Margin="0,8,0,0" Foreground="White" TextWrapping="Wrap" />
    </Grid>
</Window>