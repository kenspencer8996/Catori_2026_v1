<Window x:Class="CatoriApp.Game.Views.Manufacturing.InventoryListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory" Height="620"  Width="900"  WindowStyle="None"
        Loaded="Window_Loaded" WindowState="Maximized"
        Background="{DynamicResource MainGradient}">
    <Grid Margin="12" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleTextBlock" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource ViewHeaderForeground}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="New" Width="80" Height="30" Margin="6,0,0,0" Click="NewButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
               
            </StackPanel>
        <Button x:Name="ExitButton" Grid.Column="3" 
                Style="{StaticResource MapHotspotButton}"
                Width="50" Height="50" HorizontalAlignment="Right"
                Click="ExitButton_Click"
                   ToolTip="Click to exit"
                Panel.ZIndex="1002" />
        <DataGrid x:Name="InventoryDataGrid" Grid.Row="1" Grid.ColumnSpan="4" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Background="{x:Null}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Inventory Id" Binding="{Binding InventoryId}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Product Id" Binding="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Location" Binding="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityOnHand, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdated}" Width="180" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Margin="0,8,0,0" Foreground="White" TextWrapping="Wrap" />
    </Grid>
</Window>