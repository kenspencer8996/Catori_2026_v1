<Window x:Class="CatoriApp.Game.Views.Manufacturing.ProductEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Editor"
        Height="360"
        Width="620"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" WindowStyle="None"
        Background="{DynamicResource MainGradient}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="142*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Product Detail" Style="{DynamicResource RedBoldLabelStyle}"  />
        <Grid Grid.Row="3" Grid.RowSpan="4" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="308*" />
                <ColumnDefinition Width="81*"/>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="34*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="24" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Name" Margin="0,0,0,26" Grid.RowSpan="2" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="4" Margin="0,0,0,26" Grid.RowSpan="2" />
            <Label Grid.Row="1" Grid.Column="0" Content="Code" Margin="0,0,0,26" Grid.RowSpan="2" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="4" Margin="0,0,0,26" Grid.RowSpan="2" />
            <Label Grid.Row="2" Grid.Column="0" Content="Type" Margin="0,0,0,26" Grid.RowSpan="2" />
            <ComboBox x:Name="ProductTypeComboBox" Grid.Row="2" Grid.Column="1" SelectedItem="{Binding ProductType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="4" Margin="0,0,0,26" Grid.RowSpan="2" />
            <Label Grid.Row="3" Grid.Column="0" Content="Unit" Margin="0,0,0,26" Grid.RowSpan="2" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding UnitOfMeasure, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="4" Margin="0,0,0,26" Grid.RowSpan="2" />
            <Label Grid.Row="3" Grid.Column="0" Content="Cost" Margin="0,32,0,0" Grid.RowSpan="2" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CostPerUnit, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="4" Margin="0,32,0,0" Grid.RowSpan="2" />
            <Button x:Name="BOMButton" Grid.Column="1" Content="BOM" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="6" VerticalAlignment="Top" Click="BOMButton_Click"/>
        </Grid>
        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Grid.ColumnSpan="2">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
            <Button Content="Ok" Width="80" Click="OkButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
        </StackPanel>
    </Grid>
</Window>