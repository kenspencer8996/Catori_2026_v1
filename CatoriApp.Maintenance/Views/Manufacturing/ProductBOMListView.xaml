<Window x:Class="CatoriApp.Game.Views.Manufacturing.ProductBOMListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product BOM"
        Height="620"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" WindowStyle="None"
        Background="{DynamicResource MainGradient}">
    <Grid Margin="12" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Grid.Row="0" Content="Product Detail" Style="{DynamicResource RedBoldLabelStyle}"  />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New" Width="80" Height="30" Margin="6,0,0,0" Click="NewButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
                <Button Content="Edit" Width="80" Height="30" Margin="6,0,0,0" Click="EditButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
                <Button Content="Save" Width="80" Height="30" Margin="6,0,0,0" Click="SaveButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
                <Button Content="Close" Width="80" Height="30" Margin="6,0,0,0" Click="CloseButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="BOMDataGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Background="{DynamicResource MainGradient}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bom Id" Binding="{Binding BomId}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Parent Product" Binding="{Binding ParentProductId, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                <DataGridTextColumn Header="Component Id" Binding="{Binding ComponentId, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                <DataGridTextColumn Header="Component" Binding="{Binding ComponentName}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                <DataGridTextColumn Header="Scrap %" Binding="{Binding ScrapFactor, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                <DataGridTextColumn Header="Total" Binding="{Binding QuantityIncludingScrap}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveDate, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}" Width="130" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Margin="0,8,0,0" Foreground="White" TextWrapping="Wrap" />
    </Grid>
</Window>