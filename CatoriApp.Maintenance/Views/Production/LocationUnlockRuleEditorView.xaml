<Window x:Class="CatoriApp.Maintenance.Views.Production.LocationUnlockRuleEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Location Unlock Rule Detail" Height="430" Width="760" WindowStartupLocation="CenterOwner" Background="{DynamicResource MainGradient}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="45" /></Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Location Unlock Rule Detail" Style="{DynamicResource RedBoldLabelStyle}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Location Id" /><TextBox Grid.Row="0" Grid.Column="1" Width="140" HorizontalAlignment="Left" Text="{Binding LocationId, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="1" Content="Required Money" /><TextBox Grid.Row="1" Grid.Column="1" Width="140" HorizontalAlignment="Left" Text="{Binding RequiredMoney, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="2" Content="Required Product Location Id" /><TextBox Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left" Text="{Binding RequiredProductIdLocationId, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="3" Content="Required Product Count" /><TextBox Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left" Text="{Binding RequiredProductCount, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="4" Content="Unlock Description" /><TextBox Grid.Row="4" Grid.Column="1" MinWidth="420" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding UnlockDescription, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
            <Button Content="Ok" Width="80" Click="OkButton_Click" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />
        </StackPanel>
    </Grid>
</Window>