<Window x:Class="CatoriApp.MachineLayoutDesigner.Views.MachineCatalog.MachineInstanceEditorListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Machine Instances"
        Height="760" WindowState="Maximized"
        Width="1160"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Background="{DynamicResource MainGradient}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Content="Machine Instances" Style="{DynamicResource RedBoldLabelStyle}"  />
        <Button x:Name="NewInstanceButton" Grid.Column="1" Content="New" MinWidth="50" Width="100" Click="NewInstanceButton_Click" Height="25"  Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}" />

        <Button x:Name="ExitButton" Grid.Column="2" Style="{StaticResource MapHotspotButton}" Width="50" Height="50" Canvas.Left="1872" Canvas.Top="5" 
                Click="ExitButton_Click" ToolTip="Click to exit" Panel.ZIndex="1002" />

        <DataGrid x:Name="MainDataGrid" Grid.Row="1" Grid.ColumnSpan="3" SelectionChanged="DataGrid_SelectionChanged" Background="{DynamicResource MainGradient}"
                  ItemsSource="{Binding Instances}"
                  SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Instance" Binding="{Binding InstanceName}" Width="48" />
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="DefaultScale" Binding="{Binding DefaultScale, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <DataGridTextColumn Header="Default X" Binding="{Binding DefaultX, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                <DataGridTextColumn Header="Default X" Binding="{Binding DefaultY, UpdateSourceTrigger=PropertyChanged}" Width="64" />
                <DataGridTextColumn Header="DefaultWidth" Binding="{Binding DefaultWidth, UpdateSourceTrigger=PropertyChanged}" Width="56" />
                <DataGridTextColumn Header="DefaultHeight" Binding="{Binding DefaultHeight, UpdateSourceTrigger=PropertyChanged}" Width="56" />
                <DataGridTextColumn Header="Overlap" Binding="{Binding Overlap, UpdateSourceTrigger=PropertyChanged}" Width="70" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick"
               Handler="DataGridRow_MouseDoubleClick"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</Window>
