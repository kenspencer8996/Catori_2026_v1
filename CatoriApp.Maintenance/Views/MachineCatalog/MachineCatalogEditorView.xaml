<Window x:Class="CatoriApp.MachineLayoutDesigner.Views.MachineCatalog.MachineCatalogEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Machine Catalog Detail"
        Height="400"
        Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainGradient}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto " />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Product Detail" Style="{DynamicResource RedBoldLabelStyle}"  />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Type" />
            <ComboBox x:Name="MachineTypeComboBox"
                      Grid.Row="0"
                      Grid.Column="1"
                      MinWidth="220"
                      HorizontalAlignment="Left"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Name"
                      SelectedValue="{Binding MachineType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="1" Grid.Column="0" Content="Name" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     MinWidth="320"
                     HorizontalAlignment="Left"
                     Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="2" Grid.Column="0" Content="Default Width" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Width="120"
                     HorizontalAlignment="Left"
                     Text="{Binding DefaultWidth, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="3" Grid.Column="0" Content="Default Height" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Width="120"
                     HorizontalAlignment="Left"
                     Text="{Binding DefaultHeight, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="4" Grid.Column="0" Content="Description" />
            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     MinWidth="420"
                     MinHeight="90"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource ButtonForeground}" />
            <Button x:Name="OkButton"
                    Content="Ok"
                    Width="80"
                    Click="OkButton_Click"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource ButtonForeground}" />
        </StackPanel>
    </Grid>
</Window>